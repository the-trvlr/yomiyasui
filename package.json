{
  "name": "yomiyasui",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "読みやすい — браузерная читалка японского с фуриганой и словарём",
  "license": "MIT",
  "homepage": "https://the-trvlr.github.io/yomiyasui/",
  "repository": {
    "type": "git",
    "url": "https://github.com/the-trvlr/yomiyasui.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "baseline": "node scripts/prepare-baseline.mjs",
    "check": "node scripts/check-html.mjs site/index.html",
    "lint": "eslint .",
    "format": "prettier --write \"scripts/**/*.mjs\" \"tests/**/*.mjs\" \"site/config.js\" \"eslint.config.mjs\" \"package.json\"",
    "format:check": "prettier --check \"scripts/**/*.mjs\" \"tests/**/*.mjs\" \"site/config.js\" \"eslint.config.mjs\" \"package.json\"",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "smoke": "node scripts/smoke.mjs",
    "smoke:full": "node scripts/smoke.mjs --full",
    "dictionary": "node --max-old-space-size=4096 scripts/build-dictionary.mjs",
    "measure": "node scripts/measure.mjs",
    "verify": "npm run check && npm run lint && npm run format:check && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "prettier": "^3.6.2"
  }
}
